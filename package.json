{
  "name": "kisangati",
  "version": "0.1.0",
  "private": true,
  "description": "KisanGati — rural tractor spare-parts delivery, WhatsApp intake prototype",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
