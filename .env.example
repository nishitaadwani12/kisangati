# Server
PORT=3000

# Auth — set a long random string before deploying (dashboard login sessions)
JWT_SECRET=change-me-to-a-long-random-string

# Meta WhatsApp Cloud API (fill in from Meta developer console — Step 2)
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=your_temporary_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Database (Step 1 — Prisma). SQLite day-1 shortcut:
DATABASE_URL="file:./dev.db"

# UPI payee (used to build the payment link/QR)
UPI_VPA=shop@upi
UPI_PAYEE_NAME=KisanGati

# Commercial parameters (tunable — see src/lib/money.ts). Values in rupees / percent.
DELIVERY_FEE_RUPEES=40
FREE_DELIVERY_THRESHOLD_RUPEES=1000
CASHBACK_PERCENT=4
# Default mistri discount off the farmer retail price, used when a SKU has no explicit mistriPrice
MISTRI_DISCOUNT_PERCENT=10
